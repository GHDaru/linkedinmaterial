{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "msg/1",
  "title": "Mensagem msg/1",
  "type": "object",
  "required": ["protocolo", "id", "de", "para", "criada_em", "tipo", "conversa", "assunto", "corpo"],
  "properties": {
    "protocolo": {"const": "msg/1"},
    "id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9_]+-[0-9a-f]{4}$"},
    "de": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "para": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "criada_em": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "tipo": {"enum": ["pedido", "resposta", "evento", "recibo", "erro"]},
    "conversa": {"type": "string"},
    "responde_a": {"type": ["string", "null"]},
    "assunto": {"type": "string", "minLength": 1, "maxLength": 120},
    "corpo": {"type": "string"},
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caminho"],
        "properties": {"caminho": {"type": "string"}, "ref": {"type": "string"}}
      }
    },
    "prioridade": {"enum": ["normal", "alta"]},
    "prazo": {"type": ["string", "null"]}
  }
}
